# ColdRoute Intelligence Platform — Variables de entorno
# Copia este archivo como .env y completa los valores

APP_NAME=ColdRoute Intelligence Platform
VERSION=1.0.0
DEBUG=False

# API Keys (obtener en las plataformas respectivas)
ANTHROPIC_API_KEY=sk-ant-...

# Base de datos (Supabase gratuito)
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/coldroute

# Redis (Upstash gratuito)
REDIS_URL=redis://default:password@upstash.io:6379

# Seguridad
SECRET_KEY=cambia-esto-por-una-clave-segura
